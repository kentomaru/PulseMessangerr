# Строка подключения к PostgreSQL (обязательно)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pulse

# Уровень логов: debug | info | warn | error (по умолчанию info)
LOG_LEVEL=info

# Публичный адрес приложения — подставляется в ссылки-приглашения
# (группа: …/#group=<token>, звонок: …/#join=<token>).
# Если не задан, ссылка собирается от текущего origin браузера.
# APP_URL=https://pulse.up.railway.app

# TURN-сервер для звонков за строгим NAT (симметричный NAT, мобильные операторы).
# Публичного STUN хватает почти всегда, так что это необязательно.
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=pulse
# NEXT_PUBLIC_TURN_CREDENTIAL=secret
