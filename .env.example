# Строка подключения к PostgreSQL (обязательно)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pulse

# Уровень логов: debug | info | warn | error (по умолчанию info)
LOG_LEVEL=info

# Необязательно: TURN-сервер для звонков в сетях, где STUN недостаточно.
# Значения NEXT_PUBLIC_* попадут в браузерный bundle, используйте credentials
# отдельного TURN-сервера, а не пароль от базы.
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=...
# NEXT_PUBLIC_TURN_CREDENTIAL=...
